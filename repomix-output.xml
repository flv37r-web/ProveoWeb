const db = require('../db');

const parseFotos = (fotos) => {
  if (Array.isArray(fotos)) return fotos;
  if (typeof fotos === 'string') {
    try { return JSON.parse(fotos); } catch { return []; }
  }
  return [];
};

const buscarProveedores = async (servicio = '', zona = '') => {
  const result = await db.query(
    `SELECT p.usuario_id AS proveedor_id, u.nombre, p.nombre_negocio,
            p.tipo_servicio, p.formacion, p.descripcion, p.servicio_domicilio,
            p.colonia, p.codigo_postal, p.foto_perfil_url, p.fotos_trabajo,
            p.solo_cotizacion, p.costo_aproximado, p.direccion_maps,
            p.telefono, p.promedio_calificacion, p.total_resenas
     FROM perfiles_proveedor p
     JOIN usuarios u ON u.id = p.usuario_id
     WHERE u.estatus = 'activo'
       AND p.tipo_servicio IS NOT NULL
       AND p.tipo_servicio <> ''
       AND (? = '' OR p.tipo_servicio LIKE ? OR p.nombre_negocio LIKE ? OR p.descripcion LIKE ?)
       AND (? = '' OR p.colonia LIKE ? OR p.codigo_postal LIKE ?)
     ORDER BY p.promedio_calificacion DESC, u.creado_en DESC`,
    [
      servicio, `%${servicio}%`, `%${servicio}%`, `%${servicio}%`,
      zona, `%${zona}%`, `%${zona}%`
    ]
  );

  return result.rows.map((row) => ({
    ...row,
    servicio_domicilio: row.servicio_domicilio === null ? null : Boolean(row.servicio_domicilio),
    solo_cotizacion: row.solo_cotizacion === null ? null : Boolean(row.solo_cotizacion),
    fotos_trabajo: parseFotos(row.fotos_trabajo),
  }));
};

const obtenerPerfil = async (usuarioId) => {
  const result = await db.query(
    `SELECT u.nombre, p.nombre_negocio, p.tipo_servicio, p.formacion,
            p.servicio_domicilio, p.colonia, p.codigo_postal, p.foto_perfil_url,
            p.fotos_trabajo, p.solo_cotizacion, p.costo_aproximado,
            p.direccion_maps, p.descripcion, p.telefono
     FROM perfiles_proveedor p
     JOIN usuarios u ON u.id = p.usuario_id
     WHERE p.usuario_id = ?`,
    [usuarioId]
  );

  const row = result.rows[0];
  if (!row) return null;
  return {
    ...row,
    servicio_domicilio: row.servicio_domicilio === null ? null : Boolean(row.servicio_domicilio),
    solo_cotizacion: row.solo_cotizacion === null ? null : Boolean(row.solo_cotizacion),
    fotos_trabajo: parseFotos(row.fotos_trabajo),
  };
};

const guardarPerfil = async (usuarioId, perfil) => {
  return db.transaction(async (client) => {
    await client.query(
      'UPDATE usuarios SET nombre = ?, telefono = ? WHERE id = ?',
      [perfil.nombre, perfil.telefono, usuarioId]
    );

    const fotosJson = JSON.stringify(perfil.fotos_trabajo || []);

    await client.query(
      `INSERT INTO perfiles_proveedor (
         usuario_id, telefono, nombre_negocio, tipo_servicio, formacion,
         servicio_domicilio, colonia, codigo_postal, foto_perfil_url,
         fotos_trabajo, solo_cotizacion, costo_aproximado, direccion_maps, descripcion
       )
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
       ON DUPLICATE KEY UPDATE
         nombre_negocio = VALUES(nombre_negocio),
         tipo_servicio = VALUES(tipo_servicio),
         formacion = VALUES(formacion),
         servicio_domicilio = VALUES(servicio_domicilio),
         colonia = VALUES(colonia),
         codigo_postal = VALUES(codigo_postal),
         foto_perfil_url = VALUES(foto_perfil_url),
         fotos_trabajo = VALUES(fotos_trabajo),
         solo_cotizacion = VALUES(solo_cotizacion),
         costo_aproximado = VALUES(costo_aproximado),
         direccion_maps = VALUES(direccion_maps),
         descripcion = VALUES(descripcion),
         telefono = VALUES(telefono)`,
      [
        usuarioId,
        perfil.telefono,
        perfil.nombre_negocio,
        perfil.tipo_servicio,
        perfil.formacion,
        perfil.servicio_domicilio,
        perfil.colonia,
        perfil.codigo_postal,
        perfil.foto_perfil_url,
        fotosJson,
        perfil.solo_cotizacion,
        perfil.costo_aproximado,
        perfil.direccion_maps,
        perfil.descripcion,
      ]
    );

    return {
      nombre: perfil.nombre,
      nombre_negocio: perfil.nombre_negocio,
      tipo_servicio: perfil.tipo_servicio,
      formacion: perfil.formacion,
      servicio_domicilio: perfil.servicio_domicilio,
      colonia: perfil.colonia,
      codigo_postal: perfil.codigo_postal,
      foto_perfil_url: perfil.foto_perfil_url,
      fotos_trabajo: perfil.fotos_trabajo || [],
      solo_cotizacion: perfil.solo_cotizacion,
      costo_aproximado: perfil.costo_aproximado,
      direccion_maps: perfil.direccion_maps,
      descripcion: perfil.descripcion,
      telefono: perfil.telefono,
    };
  });
};

module.exports = { buscarProveedores, obtenerPerfil, guardarPerfil };
