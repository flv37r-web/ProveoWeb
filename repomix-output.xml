              >
                ✕
              </button>
            </div>

            <div className="py-6 space-y-4 text-sm text-gray-700">
              {proveedorSeleccionado.formacion && (
                <div>
                  <h4 className="font-bold text-gray-900">Formación y experiencia:</h4>
